{
  "name": "cmake-vscode-studio",
  "productName": "CV Studio",
  "version": "2.0.3",
  "description": "CV Studio —— 面向 CMake + VSCode 的嵌入式工程配置器：检测工程、生成并修改 .vscode 配置、管理 CMake 目标与源文件",
  "main": "./out/main/index.js",
  "author": "PoXia",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "set \"ELECTRON_RUN_AS_NODE=\" && electron-vite dev -- --no-sandbox",
    "dev:debug": "set \"ELECTRON_RUN_AS_NODE=\" && electron-vite dev --sourcemap -- --no-sandbox",
    "dev:inspect": "set \"ELECTRON_RUN_AS_NODE=\" && electron-vite dev --inspect --sourcemap -- --no-sandbox",
    "dev:brk": "set \"ELECTRON_RUN_AS_NODE=\" && electron-vite dev --inspectBrk --sourcemap -- --no-sandbox",
    "build": "electron-vite build",
    "preview": "set \"ELECTRON_RUN_AS_NODE=\" && electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"tools/**/*.{ts,mjs}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"tools/**/*.{ts,mjs}\"",
    "selftest": "node tools/run-ts.mjs tools/selftest.ts",
    "scan": "node tools/run-ts.mjs tools/scan.ts",
    "dist": "electron-vite build && electron-builder --win --dir",
    "dist:installer": "electron-vite build && electron-builder --win",
    "dist:portable": "electron-vite build && electron-builder --win portable",
    "verify:signature": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/verify-signature.ps1",
    "open:release": "powershell -NoProfile -Command \"Start-Process (Join-Path (Get-Location) 'release')\"",
    "version:patch": "npm version --no-git-tag-version patch",
    "version:minor": "npm version --no-git-tag-version minor",
    "version:major": "npm version --no-git-tag-version major",
    "postinstall": "node tools/ensure-electron.mjs",
    "dist:copy": "node tools/copy-release.mjs",
    "dist:setup": "node tools/build-installer.mjs"
  },
  "dependencies": {
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^45.2.3",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "prettier": "^3.9.10",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "~5.9.3",
    "vite": "^7.3.7"
  }
}
